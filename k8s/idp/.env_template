##--> Copy this file to .env and fill in the licenses.
## An exported value wins over anything set here, so a per-run override still
## works: TYK_DB_LICENSEKEY=... task -d k8s/idp install

# [mandatory] Dashboard license. Every tenant the controller deploys reads it
# from the tyk-stack secret, so an empty value fails far from its cause.
TYK_DB_LICENSEKEY=%license%

# [mandatory] MDCB license.
TYK_MDCB_LICENSEKEY=%license%

# [optional] Path to a TykTechnologies/idp-controller checkout. Defaults to a
# sibling of tyk-pro.
# IDP_CONTROLLER_ROOT=../../../idp-controller

# [optional] Released image tag for the controller and api-server.
# IDP_IMAGE_TAG=v0.0.10

# [optional] Installs kube-prometheus-stack with the tenant dashboards.
# INSTALL_MONITORING=true
